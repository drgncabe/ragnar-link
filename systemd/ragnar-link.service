[Unit]
Description=Ragnar Link ESP-NOW USB bridge
After=network.target

[Service]
Type=simple
User=ragnar-link
Group=ragnar-link
RuntimeDirectory=ragnar-link
RuntimeDirectoryMode=0755
ExecStart=/opt/ragnar-link/host/.venv/bin/ragnar-linkd --config /etc/ragnar-link/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

